<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M9P4"/>
        <attribute name="authors" value="rafae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-21 07:01:24 PM"/>
        <attribute name="created" value="cmFmYWU7UkFGQTsyMDI2LTExLTIxOzEyOjI3OjA5IEFNOzIwNTg="/>
        <attribute name="edited" value="cmFmYWU7UkFGQTsyMDI2LTExLTIxOzA3OjAxOjI0IFBNOzE7MjE3NA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="lastName" type="String" array="False" size=""/>
            <declare name="jobCode" type="String" array="False" size=""/>
            <declare name="hours" type="Real" array="False" size=""/>
            <declare name="payRate" type="Real" array="False" size=""/>
            <declare name="grossPay" type="Real" array="False" size=""/>
            <declare name="totalGross" type="Integer" array="False" size=""/>
            <assign variable="totalGross" expression="0"/>
            <output expression="&quot;Enter employee last name, or X to stop:&quot;" newline="True"/>
            <input variable="lastName"/>
            <while expression="lastName != &quot;X&quot;">
                <output expression="&quot;Enter job code:&quot;" newline="True"/>
                <input variable="jobCode"/>
                <output expression="&quot;Enter hours worked:&quot;" newline="True"/>
                <input variable="hours"/>
                <assign variable="payRate" expression="getPayRate(jobCode)"/>
                <if expression="hours &gt; 40">
                    <then>
                        <assign variable="grossPay" expression="40 * payRate + (hours - 40) * payRate * 1.5"/>
                    </then>
                    <else>
                        <assign variable="grossPay" expression="hours * payRate"/>
                    </else>
                </if>
                <assign variable="totalGross" expression="totalGross + grossPay"/>
                <output expression="lastName &amp; &quot; $&quot; &amp; grossPay" newline="True"/>
                <output expression="&quot;Enter employee last name, or X to stop:&quot;" newline="True"/>
                <input variable="lastName"/>
            </while>
            <output expression="&quot;Total gross pay: $&quot; &amp; totalGross" newline="True"/>
        </body>
    </function>
    <function name="getPayRate" type="Real" variable="payRate">
        <parameters>
            <parameter name="jobCode" type="String" array="False"/>
        </parameters>
        <body>
            <declare name="payRate" type="Real" array="False" size=""/>
            <if expression="jobCode == &quot;L&quot;">
                <then>
                    <assign variable="payRate" expression="25"/>
                </then>
                <else>
                    <if expression="jobCode == &quot;A&quot;">
                        <then>
                            <assign variable="payRate" expression="30"/>
                        </then>
                        <else>
                            <assign variable="payRate" expression="50"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
